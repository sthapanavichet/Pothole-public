# Store reports/images locally instead of using Supabase.
LOCAL_STORAGE_MODE=1

# Supabase project used when LOCAL_STORAGE_MODE is not 1.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=pothole-images

# Local API auth. Use the same write key in backend/.env and on the Pi.
API_WRITE_KEY=local-dev-write-key

# Optional. Leave blank to make dashboard reads open on your local network.
API_READ_KEY=

# Allow the local dashboard origins to call this API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.137.1:5173


