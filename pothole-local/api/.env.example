# Copy this file to .env.local and fill in your values
# Get URL from: Supabase Dashboard -> Data API -> Project URL
# Get keys from: Settings -> API Keys -> Secret keys (sb_secret_...)
# If you get connection errors, try the Legacy service_role key instead:
# Settings -> API Keys -> "Legacy anon, service_role API keys" tab

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here
SUPABASE_STORAGE_BUCKET=pothole-images

# API auth (generate long random strings; never commit real values)
# Required for POST/PATCH/DELETE/backfill
API_WRITE_KEY=replace_with_long_random_write_key
# Required for GET /api/reports when set (dashboard uses this via VITE_API_READ_KEY)
API_READ_KEY=replace_with_long_random_read_key

# Comma-separated browser origins allowed to call the API (CORS)
# Local Vite defaults are always included.
# CORS_ALLOWED_ORIGINS=https://your-dashboard.vercel.app
