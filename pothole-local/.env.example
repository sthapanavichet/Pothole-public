# Shared API used by Streamlit, dashboard, and Pi during LAN testing.
POTHOLE_API_URL=http://192.168.137.1:3000
VITE_API_URL=http://192.168.137.1:3000

# Optional read key for dashboard requests, if API_READ_KEY is configured.
VITE_API_READ_KEY=

# Must match API_WRITE_KEY in api/.env.local.
POTHOLE_API_WRITE_KEY=local-dev-write-key


