# Dashboard environment
# Copy to .env.local.

# Local API running on the PC. The Pi is 192.168.137.137 and the PC is 192.168.137.1.
VITE_API_URL=http://192.168.137.1:3000

# Must match API_READ_KEY in ../api/.env.local if reads are protected.
# Leave blank when API_READ_KEY is blank.
VITE_API_READ_KEY=


