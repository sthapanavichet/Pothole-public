# Copy this file to .env.local and fill in your values
# Get URL from: Supabase Dashboard -> Data API -> Project URL
# Get keys from: Settings -> API Keys -> Secret keys (sb_secret_...)
# If you get connection errors, try the Legacy service_role key instead:
# Settings -> API Keys -> "Legacy anon, service_role API keys" tab

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here
SUPABASE_STORAGE_BUCKET=pothole-images
